<!--        </Button>-->
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/recipient_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Recipient:"
                android:textSize="18sp"
                android:textStyle="bold" />
            <!-- Phone Number Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.hbb20.CountryCodePicker
                    android:id="@+id/countryCodePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:ccp_defaultNameCode="US"
                    app:ccp_showFlag="true"
                    android:textStyle="bold"
                    app:ccp_showNameCode="false"
                    app:ccp_showFullName="false"
                    app:ccp_showPhoneCode="true" />
<!--                <TextView-->
<!--                    android:id="@+id/phone_number_display"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginTop="10dp"-->
<!--                    android:layout_marginBottom="16dp"-->
<!--                    android:maxLines="1"-->
<!--                    android:textColor="@android:color/black"-->
<!--                    android:textSize="24sp"-->
<!--                    android:textStyle="bold" />-->

                <EditText
                    android:id="@+id/sv_search_user"
                    android:layout_width="284dp"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionDone"
                    android:layout_weight="1" />
            </LinearLayout>

        </LinearLayout>



    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_selected_contact_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="#FFFFFF">

        <!-- Name -->
        <TextView
            android:id="@+id/tv_selected_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEMA SHARMA"
            android:textSize="24sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Phone Number -->
        <TextView
            android:id="@+id/tv_selected_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+917986329708"
            android:textSize="18sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#EAF2FF"
            android:elevation="4dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:layout_gravity="center">

            <!-- Company Name -->
            <TextView
                android:id="@+id/tv_selected_company"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIND2WEB"
                android:textSize="18sp"
                android:textColor="#437DFF"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

<!--            &lt;!&ndash; Email &ndash;&gt;-->
<!--            <TextView-->
<!--                android:id="@+id/tv_selected_email"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="hemasharma.mind2web@gmail.com"-->
<!--                android:textSize="16sp"-->
<!--                android:textColor="#437DFF"-->
<!--                android:gravity="center"-->
<!--                android:layout_marginBottom="8dp" />-->

            <!-- Address -->
<!--            <TextView-->
<!--                android:id="@+id/tv_selected_address"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="Ashland Ave"-->
<!--                android:textSize="16sp"-->
<!--                android:textColor="#437DFF"-->
<!--                android:gravity="center" />-->
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1.4"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/suggested_user_list_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />
    </LinearLayout>


