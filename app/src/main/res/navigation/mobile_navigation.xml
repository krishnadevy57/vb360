<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_dashboard">
    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.mind2web.vb360.ui.dashboard.DashboardFragment"
        android:label="@string/title_contacts"
        tools:layout="@layout/fragment_chat_user_list" />

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.mind2web.vb360.ui.home.HomeFragment"
        android:label="@string/title_dailpad"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.mind2web.vb360.ui.notifications.SendMessagesFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_send_messages" />
    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.mind2web.vb360.ui.settings.SendEmailFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_send_messages" />
</navigation>